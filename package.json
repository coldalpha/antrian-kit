{
  "name": "antrian-kit",
  "version": "0.1.0",
  "private": true,
  "description": "Reusable Queue Calling SDK, Audio Engine, and Realtime Display for Cross-Platform Queue Management",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "node ./node_modules/typescript/bin/tsc -b",
    "clean": "node ./node_modules/typescript/bin/tsc -b --clean",
    "test": "node --test packages/core/dist/test/*.test.js packages/audio/dist/test/*.test.js"
  },
  "keywords": [
    "queue",
    "antrian",
    "audio-engine",
    "state-machine",
    "cross-platform"
  ],
  "author": "coldalpha",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
